classDiagram
    class Owner {
        +string name
        +List~Pet~ pets
        +add_pet(pet: Pet)
    }

    class Pet {
        +string name
        +string species
        +List~Task~ tasks
        +add_task(task: Task)
    }

    class Task {
        +int task_id
        +string description
        +int duration
        +string priority
        +string time_slot
        +bool is_completed
        +mark_completed()
        +edit_details(new_details: dict)
    }

    class Scheduler {
        +Owner owner
        +get_available_time(date: date) int
        +generate_daily_plan() List~Task~
    }

    Owner "1" --> "many" Pet : has
    Pet "1" --> "many" Task : has
    Scheduler --> Owner : reads data from